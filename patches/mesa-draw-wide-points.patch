@@ -139,6 +139,8 @@ void draw_wide_point_threshold(struct dr
 
 void draw_wide_point_sprites(struct draw_context *draw, bool draw_sprite);
 
+void draw_wide_point_gl(struct draw_context *draw, bool gl);
+
 void draw_wide_line_threshold(struct draw_context *draw, float threshold);
 
 void draw_enable_line_stipple(struct draw_context *draw, bool enable);
diff -urNp a/src/gallium/auxiliary/draw/draw_pipe_wide_point.c b/src/gallium/auxiliary/draw/draw_pipe_wide_point.c
--- a/src/gallium/auxiliary/draw/draw_pipe_wide_point.c	2026-10-11 20:23:18.593294088 +0200
+++ b/src/gallium/auxiliary/draw/draw_pipe_wide_point.c	2026-10-11 20:23:18.594294099 +0200
@@ -70,6 +70,7 @@ struct widepoint_stage {
 
    float xbias;
    float ybias;
+   bool gl;
 
    /** for automatic texcoord generation/replacement */
    unsigned num_texcoord_gen;
@@ -153,6 +154,20 @@ widepoint_point(struct draw_stage *stage
       half_size = wide->half_point_size;
    }
 
+   /* GL 3.4.1: odd widths centre on the pixel holding the vertex, even
+    * widths on the nearest pixel corner. */
+   if (wide->gl && !sprite) {
+      const float w = MAX2(1.0f, floorf(2.0f * half_size + 0.5f));
+      const float snap = ((int)w & 1) ? 0.5f : 0.0f;
+
+      half_size = 0.5f * w;
+      for (unsigned i = 0; i < 2; i++) {
+         const float c = floorf(pos0[i] + 0.5f - snap) + snap;
+
+         pos0[i] = pos1[i] = pos2[i] = pos3[i] = c;
+      }
+   }
+
    left_adj = -half_size + wide->xbias;
    right_adj = half_size + wide->xbias;
    bot_adj = half_size + wide->ybias;
@@ -207,8 +222,9 @@ widepoint_first_point(struct draw_stage
    wide->half_point_size = 0.5f * rast->point_size;
    wide->xbias = 0.0;
    wide->ybias = 0.0;
+   wide->gl = draw->pipeline.wide_point_gl && rast->half_pixel_center;
 
-   if (rast->half_pixel_center) {
+   if (rast->half_pixel_center && !wide->gl) {
       wide->xbias = 0.125;
       wide->ybias = -0.125;
    }
