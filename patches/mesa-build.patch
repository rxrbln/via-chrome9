 libpipe_loader_static = static_library(
   'pipe_loader_static',
diff -urNp a/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c b/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c
--- a/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c	2026-10-11 20:23:18.912297806 +0200
+++ b/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c	2026-10-11 20:23:18.913297817 +0200
@@ -67,6 +67,9 @@ struct pipe_loader_drm_device {
 static const struct pipe_loader_ops pipe_loader_drm_ops;
 
 static const struct drm_driver_descriptor *driver_descriptors[] = {
+#ifdef GALLIUM_CHROME9
+   &chrome9_driver_descriptor,
+#endif
    &i915_driver_descriptor,
    &iris_driver_descriptor,
    &crocus_driver_descriptor,
diff -urNp a/src/gallium/auxiliary/target-helpers/drm_helper.h b/src/gallium/auxiliary/target-helpers/drm_helper.h
--- a/src/gallium/auxiliary/target-helpers/drm_helper.h	2026-10-11 20:23:18.914297829 +0200
+++ b/src/gallium/auxiliary/target-helpers/drm_helper.h	2026-10-11 20:23:18.915297841 +0200
@@ -77,6 +77,17 @@ DRM_DRIVER_DESCRIPTOR(i915, NULL, 0)
 DRM_DRIVER_DESCRIPTOR_STUB(i915)
 #endif
 
+#ifdef GALLIUM_CHROME9
+#include "chrome9/chrome9_public.h"
+static struct pipe_screen *
+pipe_chrome9_create_screen(int fd, const struct pipe_screen_config *config)
+{
+   struct pipe_screen *screen = chrome9_screen_create(fd, config);
+   return screen ? debug_screen_wrap(screen) : NULL;
+}
+DRM_DRIVER_DESCRIPTOR(chrome9, NULL, 0)
+#endif
+
 #ifdef GALLIUM_IRIS
 #include "iris/drm/iris_drm_public.h"
 
diff -urNp a/src/gallium/auxiliary/target-helpers/drm_helper_public.h b/src/gallium/auxiliary/target-helpers/drm_helper_public.h
--- a/src/gallium/auxiliary/target-helpers/drm_helper_public.h	2026-10-11 20:23:18.916297852 +0200
+++ b/src/gallium/auxiliary/target-helpers/drm_helper_public.h	2026-10-11 20:23:18.917297864 +0200
@@ -28,5 +28,8 @@ extern const struct drm_driver_descripto
 extern const struct drm_driver_descriptor lima_driver_descriptor;
 extern const struct drm_driver_descriptor zink_driver_descriptor;
 extern const struct drm_driver_descriptor kmsro_driver_descriptor;
+#ifdef GALLIUM_CHROME9
+extern const struct drm_driver_descriptor chrome9_driver_descriptor;
+#endif
 
 #endif /* _DRM_HELPER_PUBLIC_H */
diff -urNp a/src/gallium/meson.build b/src/gallium/meson.build
--- a/src/gallium/meson.build	2026-10-11 20:23:18.918297876 +0200
+++ b/src/gallium/meson.build	2026-10-11 20:23:18.919297887 +0200
@@ -69,6 +69,12 @@ elif with_gallium_softpipe
