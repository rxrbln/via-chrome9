gallium: build the chrome9 driver

Add the chrome9 gallium driver option, the DRM pipe-loader descriptor and
the dri/dril targets.  chrome9 links llvmpipe for its fragment fallback,
so it is built after it.

Signed-off-by: René Rebe <rene@exactco.de>

diff -urNp a/meson.build b/meson.build
--- a/meson.build	2026-10-11 20:23:18.898297643 +0200
+++ b/meson.build	2026-10-11 20:23:18.904297712 +0200
@@ -207,7 +207,7 @@ elif gallium_drivers.contains('all')
    gallium_drivers = [
      'r300', 'r600', 'radeonsi', 'crocus', 'v3d', 'vc4', 'freedreno', 'etnaviv', 'i915',
      'nouveau', 'svga', 'tegra', 'virgl', 'lima', 'panfrost', 'llvmpipe', 'softpipe', 'iris',
-     'zink', 'd3d12', 'asahi', 'rocket', 'ethosu'
+     'zink', 'd3d12', 'asahi', 'rocket', 'ethosu', 'chrome9'
    ]
 endif
 
@@ -228,6 +228,7 @@ with_gallium_tegra = gallium_drivers.con
 with_gallium_crocus = gallium_drivers.contains('crocus')
 with_gallium_iris = gallium_drivers.contains('iris')
 with_gallium_i915 = gallium_drivers.contains('i915')
+with_gallium_chrome9 = gallium_drivers.contains('chrome9')
 with_gallium_svga = gallium_drivers.contains('svga')
 with_gallium_virgl = gallium_drivers.contains('virgl')
 with_gallium_lima = gallium_drivers.contains('lima')
@@ -263,6 +264,7 @@ with_gallium_drm = system_has_kms_drm an
   with_gallium_freedreno,
   with_gallium_lima,
   with_gallium_panfrost,
+  with_gallium_chrome9,
   with_gallium_v3d,
   with_gallium_vc4,
 ].contains(true)
diff -urNp a/meson.options b/meson.options
--- a/meson.options	2026-10-11 20:23:18.907297747 +0200
+++ b/meson.options	2026-10-11 20:23:18.908297759 +0200
@@ -85,7 +85,7 @@ option(
   value : ['auto'],
   choices : [
     'all', 'auto',
-    'asahi', 'crocus', 'd3d12', 'ethosu', 'etnaviv', 'freedreno', 'i915', 'iris',
+    'asahi', 'chrome9', 'crocus', 'd3d12', 'ethosu', 'etnaviv', 'freedreno', 'i915', 'iris',
     'lima', 'llvmpipe', 'nouveau', 'panfrost', 'r300', 'r600', 'radeonsi',
     'rocket', 'softpipe', 'svga', 'tegra', 'v3d', 'vc4', 'virgl', 'zink',
   ],
diff -urNp a/src/gallium/auxiliary/pipe-loader/meson.build b/src/gallium/auxiliary/pipe-loader/meson.build
--- a/src/gallium/auxiliary/pipe-loader/meson.build	2026-10-11 20:23:18.910297782 +0200
+++ b/src/gallium/auxiliary/pipe-loader/meson.build	2026-10-11 20:23:18.911297794 +0200
