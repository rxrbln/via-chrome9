+++ b/src/gallium/targets/dri/meson.build	2026-10-11 20:23:18.921297911 +0200
@@ -61,7 +61,7 @@ libgallium_dri = shared_library(
     driver_kmsro, driver_v3d, driver_vc4, driver_freedreno, driver_etnaviv,
     driver_tegra, driver_i915, driver_svga, driver_virgl,
     driver_panfrost, driver_iris, driver_lima, driver_zink, driver_d3d12,
-    driver_asahi, driver_crocus, driver_rocket, driver_ethosu
+    driver_asahi, driver_crocus, driver_rocket, driver_ethosu, driver_chrome9
   ],
   install : true,
   name_suffix : libname_suffix,
diff -urNp a/src/gallium/targets/dril/dril_target.c b/src/gallium/targets/dril/dril_target.c
--- a/src/gallium/targets/dril/dril_target.c	2026-10-11 20:23:18.923297934 +0200
+++ b/src/gallium/targets/dril/dril_target.c	2026-10-11 20:23:18.924297946 +0200
@@ -631,6 +631,7 @@ PUBLIC const __DRIextension **__driDrive
 }
 
 DEFINE_LOADER_DRM_ENTRYPOINT(i915)
+DEFINE_LOADER_DRM_ENTRYPOINT(chrome9)
 DEFINE_LOADER_DRM_ENTRYPOINT(iris)
 DEFINE_LOADER_DRM_ENTRYPOINT(crocus)
 DEFINE_LOADER_DRM_ENTRYPOINT(nouveau)
diff -urNp a/src/gallium/targets/dril/meson.build b/src/gallium/targets/dril/meson.build
--- a/src/gallium/targets/dril/meson.build	2026-10-11 20:23:18.926297969 +0200
+++ b/src/gallium/targets/dril/meson.build	2026-10-11 20:23:18.927297981 +0200
@@ -132,6 +132,10 @@ foreach d : [[with_gallium_kmsro, [
   endif
 endforeach
 
+if with_gallium_chrome9
+  dril_drivers += 'chrome9_dri.@0@'.format(libname_suffix)
+endif
+
 # This only works on Unix-like oses, which is probably fine for dri
 if prog_ln.found()
   foreach d : dril_drivers
