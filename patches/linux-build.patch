drm/chrome9: wire the driver into the DRM build

Add the chrome9 Kconfig and Makefile entries to drivers/gpu/drm.

Signed-off-by: René Rebe <rene@exactco.de>

diff -urNp a/drivers/gpu/drm/Kconfig b/drivers/gpu/drm/Kconfig
--- a/drivers/gpu/drm/Kconfig	2026-10-11 20:23:18.557293668 +0200
+++ b/drivers/gpu/drm/Kconfig	2026-10-11 20:23:18.558293680 +0200
@@ -307,6 +307,7 @@ source "drivers/gpu/drm/aspeed/Kconfig"
 source "drivers/gpu/drm/ast/Kconfig"
 source "drivers/gpu/drm/atmel-hlcdc/Kconfig"
 source "drivers/gpu/drm/bridge/Kconfig"
+source "drivers/gpu/drm/chrome9/Kconfig"
 source "drivers/gpu/drm/etnaviv/Kconfig"
 source "drivers/gpu/drm/exynos/Kconfig"
 source "drivers/gpu/drm/fsl-dcu/Kconfig"
diff -urNp a/drivers/gpu/drm/Makefile b/drivers/gpu/drm/Makefile
--- a/drivers/gpu/drm/Makefile	2026-10-11 20:23:18.559293691 +0200
+++ b/drivers/gpu/drm/Makefile	2026-10-11 20:23:18.560293703 +0200
@@ -211,6 +211,7 @@ obj-$(CONFIG_DRM_MEDIATEK) += mediatek/
 obj-$(CONFIG_DRM_MESON)	+= meson/
 obj-y			+= panel/
 obj-y			+= bridge/
+obj-$(CONFIG_DRM_CHROME9) += chrome9/
 obj-$(CONFIG_DRM_FSL_DCU) += fsl-dcu/
 obj-$(CONFIG_DRM_ETNAVIV) += etnaviv/
 obj-y			+= hisilicon/
